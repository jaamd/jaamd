                </a>
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <footer class="site-bar site-footer">
            <span>MIT License</span>
            <span class="site-footer-links">
                <a href="https://github.com/jaamd/jaamd">GitHub</a>
                <a href="https://www.npmjs.com/org/jaamd">npm</a>
            </span>
        </footer>
    </body>
</html>
