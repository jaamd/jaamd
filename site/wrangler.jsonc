{
    "name": "jaamd",
    "main": "./worker.ts",
    "compatibility_date": "2026-11-10",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": ["/docs", "/docs/*", "/jaad", "/jaad/*"],
    },
}
