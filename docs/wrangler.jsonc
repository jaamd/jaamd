{
    "name": "jaamd-docs",
    "main": "./worker.ts",
    "compatibility_date": "2026-11-10",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        // Pages go through the Worker for redirects and Markdown; the hashed
        // build assets need neither, and are served without it.
        "run_worker_first": ["/*", "!/_astro/*"],
    },
}
