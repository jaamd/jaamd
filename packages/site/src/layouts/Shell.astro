---
import type { ComponentProps } from 'astro/types'
import config from 'virtual:jaamd/site'
import Footer from '../components/Footer.astro'
import Head from '../components/Head.astro'
import Header from '../components/Header.astro'
// No stylesheets here: the page imports the site's, then its package's, then
// the project's, so a project's CSS comes last.

interface Props {
    title?: string | undefined
    description?: string | undefined
    bare?: boolean | undefined
    /** Added to the body. */
    class?: string | undefined
    /** What the header offers: translations and search. */
    header: ComponentProps<typeof Header>
    /** The page's own metadata, past its title and description. */
    head?: Omit<ComponentProps<typeof Head>, 'title' | 'description'> | undefined
    /** False when the page sets the footer in its own column. */
    footer?: boolean | undefined
}

const { title, description, bare = false, class: className, header, head, footer = true } = Astro.props

const pageTitle = title ? `${title} | ${config.title}` : config.title
const pageDescription = description ?? config.description ?? config.title
---

<!doctype html>
<html lang={config.lang} class={config.appearance === 'dark' ? 'dark' : undefined}>
    <head>
        <Head title={pageTitle} description={pageDescription} {...head} />
        <slot name="head" />
    </head>
    <body class:list={['site-body jaad-body', className]}>
        <Header {...header} />
        <main class={bare ? 'site-main-bare jaad-main-bare' : 'site-main jaad-main'}>
            <slot />
        </main>
        {footer && <Footer locale={header.locale} />}
    </body>
</html>
