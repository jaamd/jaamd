---
import type { ComponentProps } from 'astro/types'
import config from 'virtual:jaamd/site'
import Footer from '../components/Footer.astro'
import Head from '../components/Head.astro'
import Header from '../components/Header.astro'
// No stylesheets here: the page imports its package's, then the site's own,
// in that order, so a project's CSS comes last.

interface Props {
    title?: string
    description?: string
    bare?: boolean
    /** Added to the body. */
    class?: string
    /** What the header offers: translations and search. */
    header: ComponentProps<typeof Header>
}

const { title, description, bare = false, class: className, header } = Astro.props

const pageTitle = title ? `${title} | ${config.title}` : config.title
const pageDescription = description ?? config.description ?? config.title
---

<!doctype html>
<html lang={config.lang} class={config.appearance === 'dark' ? 'dark' : undefined}>
    <head>
        <Head title={pageTitle} description={pageDescription} />
    </head>
    <body class:list={['jaad-body', className]}>
        <Header {...header} />
        <main class={bare ? 'jaad-main-bare' : 'jaad-main'}>
            <slot />
        </main>
        <Footer />
    </body>
</html>
