---
import { ui } from '../runtime.ts'

interface Props {
    /** The page's own Markdown, fetched by "Copy page". */
    markdownHref: string
    /** Where the page's source is edited, or null to leave the link out. */
    editHref: string | null
    locale?: string
}

const { markdownHref, editHref, locale } = Astro.props
const t = ui(locale)
---

<div class="docs-page-actions">
    <button
        type="button"
        data-copy-page
        data-md-href={markdownHref}
        data-copied={t('page.copied')}
        class="docs-page-action"
    >
        <svg class="docs-page-action-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 1H4a2 2 0 00-2 2v14h2V3h12V1zm3 4H8a2 2 0 00-2 2v14a2 2 0 002 2h11a2 2 0 002-2V7a2 2 0 00-2-2z"
            ></path>
        </svg>
        <span data-copy-label>{t('page.copy')}</span>
    </button>

    {editHref && (
        <a href={editHref} target="_blank" rel="noopener noreferrer" class="docs-page-action">
            <svg class="docs-page-action-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                />
            </svg>
            <span>{t('page.edit')}</span>
        </a>
    )}
</div>

<script>
    /** Safari allows a clipboard write only while the click is being handled:
     *  a ClipboardItem starts it there and lets the Markdown arrive later. */
    async function copyMarkdown(href: string): Promise<void> {
        const text = fetch(href).then((res) => {
            if (!res.ok) throw new Error(`${href} answered ${res.status}`)
            return res.text()
        })

        if (typeof ClipboardItem === 'undefined') {
            await navigator.clipboard.writeText(await text)
            return
        }

        const blob = text.then((markdown) => new Blob([markdown], { type: 'text/plain' }))
        await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })])
    }

    function initCopyPageButtons(): void {
        document.querySelectorAll<HTMLButtonElement>('[data-copy-page]').forEach((btn) => {
            if (btn.dataset.copyInit) return
            btn.dataset.copyInit = '1'

            const label = btn.querySelector<HTMLElement>('[data-copy-label]')
            // Read once: a second click within the two seconds would read "Copied!".
            const original = label?.textContent ?? ''
            let restore: ReturnType<typeof setTimeout> | undefined

            btn.addEventListener('click', async () => {
                const href = btn.dataset.mdHref
                if (!href) return
                try {
                    await copyMarkdown(href)
                    if (label) {
                        label.textContent = btn.dataset.copied ?? 'Copied!'
                        clearTimeout(restore)
                        restore = setTimeout(() => {
                            label.textContent = original
                        }, 2000)
                    }
                } catch {
                    // Network or clipboard unavailable.
                }
            })
        })
    }

    initCopyPageButtons()
    document.addEventListener('astro:page-load', initCopyPageButtons)
</script>
