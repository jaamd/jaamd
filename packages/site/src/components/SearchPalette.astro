---
import { DEFAULT_LOCALE, ui } from '../runtime.ts'

interface Props {
    /** The search index, of the reader's locale. */
    indexUrl: string
    /** The full field on wide screens. Otherwise the palette keeps its icon
     *  trigger and its shortcut. */
    prominent?: boolean
    locale?: string
}

const { indexUrl, prominent = false, locale = DEFAULT_LOCALE } = Astro.props
const t = ui(locale)

const MAGNIFIER = 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z'
---

<site-search
    data-prominent={prominent ? '' : null}
    data-index-url={indexUrl}
    data-loading={t('search.loading')}
    data-empty={t('search.empty')}
>
    <button
        data-trigger-desktop
        hidden={!prominent}
        class="site-search-trigger jaad-search-trigger"
        aria-label={t('search.label')}
    >
        <svg
            class="site-search-trigger-icon jaad-search-trigger-icon"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
        >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={MAGNIFIER}></path>
        </svg>
        <span class="site-search-trigger-label jaad-search-trigger-label">{t('search.trigger')}</span>
        <kbd data-shortcut class="site-search-shortcut jaad-search-shortcut">
            Ctrl K
        </kbd>
    </button>

    <button
        data-trigger-icon
        class:list={[
            'site-icon-button jaad-icon-button',
            prominent && 'site-search-trigger-compact jaad-search-trigger-compact',
        ]}
        aria-label={t('search.label')}
    >
        <svg class="site-icon jaad-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={MAGNIFIER}></path>
        </svg>
    </button>

    {/* Opened with showModal(): the browser keeps focus inside and the page behind inert. */}
    <dialog data-overlay class="site-search-overlay jaad-search-overlay" aria-label={t('search.label')}>
        <div data-backdrop class="site-search-backdrop jaad-search-backdrop"></div>

        <div class="site-search-panel jaad-search-panel">
            <div class="site-search-bar jaad-search-bar">
                <svg
                    class="site-search-bar-icon jaad-search-bar-icon"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={MAGNIFIER}></path>
                </svg>
                <input
                    data-input
                    type="text"
                    placeholder={t('search.placeholder')}
                    class="site-search-input jaad-search-input"
                    autocomplete="off"
                    spellcheck="false"
                    role="combobox"
                    aria-expanded="true"
                    aria-controls="search-results"
                    aria-autocomplete="list"
                    aria-label={t('search.label')}
                />
                <button
                    type="button"
                    data-close
                    class="site-search-close jaad-search-close"
                    aria-label={t('search.close')}
                >
                    ESC
                </button>
            </div>

            <div
                data-filters
                hidden
                class="site-search-filters jaad-search-filters"
                role="group"
                aria-label={t('search.sections')}
            >
                <button type="button" data-filter="" aria-pressed="true" class="site-search-filter jaad-search-filter">
                    {t('search.all')}
                </button>
            </div>

            <ul
                data-results
                id="search-results"
                class="site-search-results jaad-search-results"
                role="listbox"
                aria-label={t('search.results')}
            ></ul>

            <div class="site-search-footer jaad-search-footer">
                <span>
                    <kbd class="site-search-key jaad-search-key">↑↓</kbd>
                    {t('search.navigate')}
                </span>
                <span>
                    <kbd class="site-search-key jaad-search-key">↵</kbd>
                    {t('search.open')}
                </span>
                <span>
                    <kbd class="site-search-key jaad-search-key">esc</kbd>
                    {t('search.close')}
                </span>
            </div>
        </div>
    </dialog>
</site-search>

<script>
    import { navigate } from 'astro:transitions/client'
    import { defineSiteSearch } from './search-palette.ts'

    defineSiteSearch(navigate)
</script>
