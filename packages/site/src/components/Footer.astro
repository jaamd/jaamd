---
import config from 'virtual:jaamd/site'
import { escapeHtml } from '../helpers.ts'
import { ui } from '../runtime.ts'
import { withDeploymentBase } from '../urls.ts'

interface Props {
    locale?: string | undefined
}

const t = ui(Astro.props.locale)

const links = config.credits.map((credit) => {
    return `<a href="${escapeHtml(credit.href)}" rel="noopener">${escapeHtml(credit.name)}</a>`
})
const credit = `Built with ${links.join(' and ')}`
const feed = config.feeds[0]
const feedLink = feed
    ? `<a href="${escapeHtml(withDeploymentBase(feed.path, import.meta.env.BASE_URL))}">${escapeHtml(t('feed.label'))}</a>`
    : ''

/** Unset is the credit, then the feed when there is one; `footer: false`
 *  removes it. A line of its own places them with `:credit` and `:feed`. */
function footerHtml(line: string | false | undefined): string | null {
    if (line === false) {
        return null
    }
    if (line === undefined) {
        // The sentence ends where the line does: before the feed, it runs on.
        return feed ? `${credit} · ${feedLink}` : `${credit}.`
    }
    return line.replaceAll(':credit', `${credit}.`).replaceAll(':feed', feedLink)
}

const html = footerHtml(config.footer)
---

{html && (
    <footer class="site-chrome jaad-chrome site-footer jaad-footer" aria-labelledby="footer-heading">
        <h2 class="site-sr-only jaad-sr-only" id="footer-heading">
            Site footer
        </h2>
        <p class="site-footer-credit jaad-footer-credit" set:html={html} />
    </footer>
)}
