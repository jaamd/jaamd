---
import type { ComponentProps } from 'astro/types'
import { Font, type CssVariable } from 'astro:assets'
import config from 'virtual:jaamd/site'
import { withDeploymentBase } from '../urls.ts'
import Meta from './Meta.astro'

/** The shell's `<head>`: the document's basics, fonts and theme, then `Meta`. */
type Props = ComponentProps<typeof Meta>

const favicon = config.favicon ? withDeploymentBase(config.favicon, import.meta.env.BASE_URL) : null

// Applied before the first paint, so the page never flashes the wrong theme.
const themeScript = `(function () {
  function isDark() {
    var t = localStorage.getItem("theme");
    return (
      t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches)
    );
  }
  function applyTheme(root) {
    if (isDark()) {
      root.classList.add("dark");
    } else {
      root.classList.remove("dark");
    }
  }
  applyTheme(document.documentElement);
  document.addEventListener("astro:before-swap", function (e) {
    applyTheme(e.newDocument.documentElement);
  });
  document.addEventListener("astro:after-swap", function () {
    applyTheme(document.documentElement);
  });
})();`
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<title>{Astro.props.title}</title>
{favicon && <link rel="icon" href={favicon} />}

<Font cssVariable="--font-inter" preload />
{/* The italic face sets only the site name in the header, which a logo replaces. */}
<Font cssVariable="--font-merriweather" preload={config.logo ? [{ style: 'normal' }] : true} />
{config.fonts.map((cssVariable) => (
    <Font cssVariable={cssVariable as CssVariable} />
))}

<Meta {...Astro.props} />

<meta name="generator" content={Astro.generator} />

{config.head.map((tag) => {
    const Tag = tag.tag as keyof HTMLElementTagNameMap
    return <Tag {...tag.attrs} set:html={tag.content ?? ''} />
})}

{config.appearance === 'auto' && <script is:inline set:html={themeScript} />}
