---
import config from 'virtual:jaamd/site'
import { withDeploymentBase } from '../urls.ts'
---

{config.nav.length > 0 && (
    <nav class="site-nav jaad-nav">
        <ul class="site-nav-list jaad-nav-list">
            {config.nav.map((link) => (
                <li>
                    <a
                        href={withDeploymentBase(link.href, import.meta.env.BASE_URL)}
                        class="site-nav-link jaad-nav-link"
                        {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
)}
