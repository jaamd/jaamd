---
import type { LocaleAlternate } from '../locales.ts'
import config from 'virtual:jaamd/site'
import { DEFAULT_LOCALE, ui } from '../runtime.ts'
import { withDeploymentBase } from '../urls.ts'
import FeedLink from './FeedLink.astro'
import LocaleSwitcher from './LocaleSwitcher.astro'
import Nav from './Nav.astro'
import NavMobile from './NavMobile.astro'
import SearchPalette from './SearchPalette.astro'
import SocialLinks from './SocialLinks.astro'
import ThemeSwitcher from './ThemeSwitcher.astro'

interface Props {
    locale?: string | undefined
    /** The page in every locale, for the switcher. */
    alternates: LocaleAlternate[]
    /** Left out on pages no search index covers. */
    search?: {
        /** `search-index.json` of the reader's locale. */
        indexUrl: string
        /** The full search field on wide screens, not just its icon. */
        prominent?: boolean
    }
}

const { locale = DEFAULT_LOCALE, alternates, search } = Astro.props
const t = ui(locale)
const homeHref = withDeploymentBase(config.homeLink, import.meta.env.BASE_URL)
const logoSrc = config.logo ? withDeploymentBase(config.logo, import.meta.env.BASE_URL) : null
---

{/* Persisted between pages of one language: a switch to another brings the
     header of that language, its labels translated. */}
<header class="site-header jaad-header" transition:persist={`site-header-${locale}`}>
    <div class="site-header-inner jaad-header-inner">
        <div class="site-header-row jaad-header-row">
            <span class="site-brand jaad-brand font-brand">
                <a href={homeHref} title={t('home')} class="site-brand-link jaad-brand-link">
                    {logoSrc ? <img src={logoSrc} alt={config.title} class="site-logo jaad-logo" /> : config.title}
                </a>
            </span>

            <div class="site-header-actions jaad-header-actions">
                {search && <SearchPalette indexUrl={search.indexUrl} prominent={search.prominent} {locale} />}
                <Nav />
                <SocialLinks />
                <FeedLink {locale} />
                {config.appearance === 'auto' && <ThemeSwitcher {locale} />}
                {alternates.length > 1 && <LocaleSwitcher {alternates} current={locale} />}
                <NavMobile {locale} />
            </div>
        </div>
    </div>
</header>
