---
import { ui } from '../runtime.ts'
import { withDeploymentBase } from '../urls.ts'

interface Props {
    locale?: string | undefined
}

const t = ui(Astro.props.locale)
const homeHref = withDeploymentBase('/', import.meta.env.BASE_URL)
---

<div class="site-not-found jaad-not-found">
    <h1 class="site-not-found-title jaad-not-found-title">404</h1>
    <p class="site-not-found-text jaad-not-found-text">{t('notFound.text')}</p>
    <a href={homeHref}>{t('notFound.home')}</a>
</div>
