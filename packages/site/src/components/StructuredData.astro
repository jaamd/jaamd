---
import config from 'virtual:jaad/config'
import { scriptJson } from '../helpers.ts'

/** A step of the page's breadcrumb; one without a url is a label only. */
export interface Crumb {
    name: string
    url: string | null
}

interface Props {
    /** The schema.org type of the page, as `TechArticle`. */
    type: string
    title: string
    description: string
    /** From the site's home to the page itself. */
    crumbs: Crumb[]
    keywords?: string[]
    author?: string
    modified?: Date
    /** BCP-47 tag of this page's locale. */
    language?: string
}

const { type, title, description, crumbs, keywords = [], author, modified, language = config.lang } = Astro.props

// Relative ids are worthless to a crawler, so without `site` emit nothing.
const data = Astro.site && {
    '@context': 'https://schema.org',
    '@type': type,
    headline: title,
    description,
    inLanguage: language,
    ...(keywords.length > 0 ? { keywords } : {}),
    ...(author ? { author: { '@type': 'Person', name: author } } : {}),
    ...(modified ? { dateModified: modified.toISOString() } : {}),
    isPartOf: { '@type': 'WebSite', name: config.title },
    breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((crumb, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: crumb.name,
            ...(crumb.url ? { item: crumb.url } : {}),
        })),
    },
}

// `<` escaped: a `</script>` in a title or description would close the element.
const json = data ? scriptJson(data) : ''
---

{data && <script type="application/ld+json" set:html={json} is:inline />}
