---
import type { StructuredDataProps } from '../structured-data.ts'
import config from 'virtual:jaamd/site'
import { absoluteAuthorUrl } from '../authors.ts'
import { scriptJson } from '../helpers.ts'

type Props = StructuredDataProps

const {
    type,
    title,
    description,
    crumbs,
    keywords = [],
    authors = [],
    published,
    modified,
    language = config.lang,
} = Astro.props

const people = authors.map((author) => {
    const url = absoluteAuthorUrl(author, import.meta.env.BASE_URL, Astro.site)
    return { '@type': 'Person', name: author.name, ...(url ? { url } : {}) }
})

// Relative ids are worthless to a crawler, so without `site` emit nothing.
const data = Astro.site && {
    '@context': 'https://schema.org',
    '@type': type,
    headline: title,
    description,
    inLanguage: language,
    ...(keywords.length > 0 ? { keywords } : {}),
    ...(people.length > 0 ? { author: people.length === 1 ? people[0] : people } : {}),
    ...(published ? { datePublished: published.toISOString() } : {}),
    ...(modified ? { dateModified: modified.toISOString() } : {}),
    isPartOf: { '@type': 'WebSite', name: config.title },
    breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((crumb, i) => {
            return {
                '@type': 'ListItem',
                position: i + 1,
                name: crumb.name,
                ...(crumb.url ? { item: crumb.url } : {}),
            }
        }),
    },
}

// `<` escaped: a `</script>` in a title or description would close the element.
const json = data ? scriptJson(data) : ''
---

{data && <script type="application/ld+json" set:html={json} is:inline />}
