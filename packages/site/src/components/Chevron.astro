---
interface Props {
    /** Where it points: back is left, forward is right. */
    direction: 'back' | 'forward'
    class: string
}

const { direction, class: className } = Astro.props
const path = direction === 'back' ? 'M15 19l-7-7 7-7' : 'M9 5l7 7-7 7'
---

<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={path}></path>
</svg>
