---
import config from 'virtual:jaamd/site'
import { buildSocialLinks } from '../social.ts'

const links = buildSocialLinks(config)
---

{links.map((link) => (
    <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        title={link.label}
        aria-label={link.label}
        class="site-icon-button jaad-icon-button"
    >
        {link.svg ? (
            <span class="site-social-icon jaad-social-icon" set:html={link.svg} />
        ) : link.path ? (
            <svg class="site-icon jaad-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={link.path} />
            </svg>
        ) : (
            <span class="site-social-label jaad-social-label">{link.label}</span>
        )}
    </a>
))}
