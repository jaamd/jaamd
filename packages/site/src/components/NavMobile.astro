---
import config from 'virtual:jaamd/site'
import { ui } from '../runtime.ts'
import { withDeploymentBase } from '../urls.ts'

const links = config.nav
const t = ui(Astro.props.locale)
---

{links.length > 0 && (
    <site-nav-mobile class="site-nav-mobile jaad-nav-mobile">
        <button
            class="site-icon-button jaad-icon-button"
            aria-label={t('nav.mobile')}
            aria-expanded="false"
            aria-controls="site-nav-menu"
        >
            <svg class="site-icon jaad-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                    data-icon-open
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"
                />
                <path
                    data-icon-close
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"
                />
            </svg>
        </button>

        <div id="site-nav-menu" data-menu hidden class="site-menu jaad-menu">
            <nav class="site-nav-mobile-links jaad-nav-mobile-links">
                <ul class="site-nav-mobile-list jaad-nav-mobile-list">
                    {links.map((link) => (
                        <li>
                            <a
                                href={withDeploymentBase(link.href, import.meta.env.BASE_URL)}
                                class="site-menu-item jaad-menu-item"
                                {...(link.href.startsWith('http')
                                    ? { target: '_blank', rel: 'noopener noreferrer' }
                                    : {})}
                            >
                                {link.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
    </site-nav-mobile>
)}

<script>
    class SiteNavMobile extends HTMLElement {
        #button!: HTMLButtonElement
        #menu!: HTMLElement
        /** Moved with the persisted header on every navigation: bound once. */
        #bound = false

        #onPointer = (e: PointerEvent) => {
            if (!this.contains(e.target as Node)) {
                this.#setOpen(false)
            }
        }
        #onKey = (e: KeyboardEvent) => {
            if (e.key === 'Escape') {
                this.#setOpen(false)
            }
        }

        #setOpen(open: boolean) {
            this.#menu.hidden = !open
            this.#button.setAttribute('aria-expanded', String(open))

            if (open) {
                document.addEventListener('pointerdown', this.#onPointer)
                document.addEventListener('keydown', this.#onKey)
            } else {
                document.removeEventListener('pointerdown', this.#onPointer)
                document.removeEventListener('keydown', this.#onKey)
            }
        }

        connectedCallback() {
            if (this.#bound) {
                return
            }
            this.#bound = true

            this.#button = this.querySelector('button')!
            this.#menu = this.querySelector('[data-menu]')!

            this.#button.addEventListener('click', () => {
                this.#setOpen(Boolean(this.#menu.hidden))
            })
            this.#menu.addEventListener('click', (e) => {
                if ((e.target as HTMLElement).closest('a')) {
                    this.#setOpen(false)
                }
            })
        }

        disconnectedCallback() {
            document.removeEventListener('pointerdown', this.#onPointer)
            document.removeEventListener('keydown', this.#onKey)
        }
    }

    if (!customElements.get('site-nav-mobile')) {
        customElements.define('site-nav-mobile', SiteNavMobile)
    }
</script>
