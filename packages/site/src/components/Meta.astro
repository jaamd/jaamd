---
import type { MetaProps } from '../meta.ts'
import config from 'virtual:jaamd/site'
import { openGraphLocale } from '../locales.ts'
import { withDeploymentBase } from '../urls.ts'

/** What a page tells search engines, social previews and agents about itself:
 *  description, canonical, alternates, feeds, Open Graph and Twitter. Every
 *  page of the shell has it through `Head`; a layout of a project's own can
 *  put it in its `<head>` alone. */
type Props = MetaProps

const {
    title,
    description,
    keywords = [],
    author,
    image,
    modified,
    language = config.lang,
    alternates = [],
    xDefault,
    markdown,
    article,
} = Astro.props
const canonical = Astro.site ? Astro.url.href : null

// Open Graph rejects relative paths, so these have to be absolute.
const resolvedImage = image ?? config.ogImage
const ogImage =
    resolvedImage === false
        ? null
        : /^https?:\/\//.test(resolvedImage)
          ? resolvedImage
          : Astro.site
            ? new URL(withDeploymentBase(resolvedImage, import.meta.env.BASE_URL), Astro.site).href
            : null
const feeds = config.feeds.map((feed) => {
    return { title: feed.title, href: withDeploymentBase(feed.path, import.meta.env.BASE_URL) }
})
---

<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
{author && <meta name="author" content={author} />}
{canonical && <link rel="canonical" href={canonical} />}
{Astro.site &&
    alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.tag} href={new URL(alternate.href, Astro.site).href} />
    ))}
{Astro.site && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site).href} />}

{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
{feeds.map((feed) => (
    <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
))}

{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={config.title} />
<meta property="og:locale" content={openGraphLocale(language)} />
{alternates
    .filter((alternate) => alternate.tag !== language)
    .map((alternate) => (
        <meta property="og:locale:alternate" content={openGraphLocale(alternate.tag)} />
    ))}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{article && <meta property="article:published_time" content={article.published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{article?.tags.map((tag) => (
    <meta property="article:tag" content={tag} />
))}
{ogImage && <meta property="og:image" content={ogImage} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
{canonical && <meta property="twitter:domain" content={Astro.url.hostname} />}
{canonical && <meta property="twitter:url" content={canonical} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
