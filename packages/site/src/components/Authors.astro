---
import type { Author } from '../authors.ts'
import config from 'virtual:jaamd/site'
import { authorHref } from '../authors.ts'

/** The authors' names as a sentence in the page's language, "Ada and Grace",
 *  each with a url a link to it. */
interface Props {
    authors: Author[]
    language?: string | undefined
}

const { authors, language = config.lang } = Astro.props

const names = authors.map((author) => {
    return author.name
})
let next = 0
const parts = new Intl.ListFormat(language, { type: 'conjunction' }).formatToParts(names).map((part) => {
    if (part.type === 'literal') {
        return { text: part.value, href: null }
    }
    const author = authors[next++]
    return { text: part.value, href: author ? authorHref(author, import.meta.env.BASE_URL) : null }
})
---

{parts.map((part) =>
    part.href ? (
        <a href={part.href} rel="author">
            {part.text}
        </a>
    ) : (
        part.text
    ),
)}
