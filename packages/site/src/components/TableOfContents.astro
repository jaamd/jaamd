---
import type { PageHeading } from '../rendered.ts'
import { ui } from '../runtime.ts'

interface Props {
    headings: PageHeading[]
    locale?: string | undefined
}

const { headings, locale } = Astro.props
const t = ui(locale)
---

{headings.length > 0 && (
    <nav id="site-toc" aria-label={t('toc.label')} class="site-toc docs-toc">
        <h2 class="site-toc-title docs-toc-title">{t('toc.title')}</h2>
        <ul class="site-toc-list docs-toc-list">
            {headings.map((heading) => (
                <li>
                    <a
                        href={`#${heading.slug}`}
                        data-toc-link
                        class:list={[
                            'site-toc-link docs-toc-link',
                            heading.depth === 3 && 'site-toc-link-nested docs-toc-link-nested',
                        ]}
                    >
                        {heading.text}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
)}

<script>
    import { initToc } from '@jaamd/astro/client'

    // The same watching as JAAMD's `:::toc`: the heading in view, measured from
    // where an anchored heading comes to rest. Each run replaces the last.
    let stop: (() => void) | undefined
    function watchToc(): void {
        stop?.()
        stop = initToc(document, { selector: '#site-toc' })
    }

    watchToc()
    document.addEventListener('astro:page-load', watchToc)
</script>
