{
    "name": "@jaamd/site",
    "version": "1.1.0",
    "description": "Internal: the site shell shared by JAAD and JAAB. Not a public API: install @jaamd/jaad or @jaamd/jaab.",
    "keywords": [
        "astro",
        "jaamd"
    ],
    "homepage": "https://docs.jaamd.org",
    "bugs": "https://github.com/jaamd/jaamd/issues",
    "license": "MIT",
    "author": "Kasui92 <info@lucapattocchio.dev>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jaamd/jaamd.git",
        "directory": "packages/site"
    },
    "files": [
        "src",
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        "./site.css": "./dist/site.css",
        "./*": "./src/*"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tailwindcss -i ./src/styles/site.css -o ./dist/site.css",
        "prepare": "pnpm build",
        "check": "astro check && tsc --noEmit -p tests",
        "test": "node --test \"tests/unit/**/*.test.ts\""
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.4",
        "@jaamd/astro": "workspace:^",
        "@types/mdast": "^4.0.4",
        "remark-directive": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-stringify": "^11.0.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@tailwindcss/cli": "^4.3.3",
        "happy-dom": "^21.0.4",
        "shiki": "^4.5.0",
        "tailwindcss": "^4.3.3"
    },
    "peerDependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "astro": "^7.3.0",
        "tailwindcss": "^4.3.0"
    },
    "peerDependenciesMeta": {
        "tailwindcss": {
            "optional": true
        },
        "@tailwindcss/vite": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.23.4"
    }
}
