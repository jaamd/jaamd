---
import type { BlogPostProps } from '../layout.ts'
import MarkdownContent from '@jaamd/astro/components'
import Authors from '@jaamd/site/components/Authors.astro'
import Footer from '@jaamd/site/components/Footer.astro'
import PageActions from '@jaamd/site/components/PageActions.astro'
import StructuredData from '@jaamd/site/components/StructuredData.astro'
import TableOfContents from '@jaamd/site/components/TableOfContents.astro'
import { fill } from '@jaamd/site/helpers.ts'
import { ui } from '@jaamd/site/runtime.ts'
import config from 'virtual:jaab/config'
import Layout from '../layouts/Blog.astro'
import { formatPostDay } from '../model/posts.ts'
import PostNav from './PostNav.astro'

type Props = BlogPostProps

const { post, headings, ownHeading, indexHref, meta } = Astro.props
const t = ui()

// The shell writes the whole title and description from the page's own.
const { title: _title, description: _description, ...head } = meta.head
// Passed through to the element; the component's props name only `as` and `class`.
const contentAttrs = { id: 'content' }
---

<Layout title={Astro.props.title} description={Astro.props.description} bare footer={false} {head}>
    {meta.structuredData && <StructuredData slot="head" {...meta.structuredData} />}

    <div class="blog-container blog-post-layout">
        <div class="blog-main">
            <article>
                <p class="blog-post-meta">
                    <a href={indexHref}>{t('blog.label')}</a>
                    <span aria-hidden="true">·</span>
                    <time datetime={post.day}>{formatPostDay(post.day, config.lang)}</time>
                    {config.blog.readingTime && (
                        <>
                            <span aria-hidden="true">·</span>
                            <span>{fill(t('blog.minutes'), { minutes: post.readingTime })}</span>
                        </>
                    )}
                    {post.authors.length > 0 && (
                        <>
                            <span aria-hidden="true">·</span>
                            <span>
                                <Authors authors={post.authors} />
                            </span>
                        </>
                    )}
                </p>

                <MarkdownContent {...contentAttrs} class="blog-content">
                    {!ownHeading && <h1>{post.title}</h1>}
                    <slot />
                </MarkdownContent>

                {post.updatedDay && (
                    <p class="blog-post-updated">
                        {t('blog.updated')}{' '}
                        <time datetime={post.updatedDay}>{formatPostDay(post.updatedDay, config.lang)}</time>
                    </p>
                )}
            </article>

            <PostNav {post} />
        </div>

        <aside class="blog-aside site-sidebar">
            <TableOfContents {headings} />
            <PageActions markdownHref={config.blog.llms ? post.markdownHref : undefined} editHref={post.editHref} />
        </aside>
        <Footer />
    </div>
</Layout>
