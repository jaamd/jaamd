---
import type { ComponentProps } from 'astro/types'
import Shell from '@jaamd/site/layouts/Shell.astro'
// The site's rules, the blog's, the type of the Markdown, then the project's own.
import '@jaamd/site/site.css'
import '../../dist/jaab.css'
import '@jaamd/site/styles/jaamd-typography.css'
import '@jaamd/astro/styles.css'
import 'virtual:jaad/theme.css'
import 'virtual:jaad/bridge.css'
import 'virtual:jaad/user.css'
import 'virtual:jaad/tailwind.css'

// The blog has no search index, and one language: the header offers neither.
type Props = Omit<ComponentProps<typeof Shell>, 'header'>
---

<Shell {...Astro.props} header={{ alternates: [] }}>
    <slot name="head" slot="head" />
    <slot />
</Shell>
