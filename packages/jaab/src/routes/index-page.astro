---
import config from 'virtual:jaab/config'
import Layout from 'virtual:jaab/layout'
import { indexPage } from '../layout.ts'
import { pageCount } from '../model/posts.ts'
import { getPosts } from '../posts.ts'

/** The index's later pages: the first is the index itself. */
export async function getStaticPaths() {
    const pages = pageCount((await getPosts()).length, config.blog.perPage)
    return Array.from({ length: pages - 1 }, (_, at) => {
        return { params: { page: String(at + 2) } }
    })
}

const { props, Content } = await indexPage(Number(Astro.params.page))
---

<Layout {...props}>{Content && <Content />}</Layout>
