---
import type { BlogPost } from '../posts.ts'
import { render } from 'astro:content'
import PostPage from '../components/PostPage.astro'
import { getPosts } from '../posts.ts'

// A post's aliases are Astro redirects, set up by the integration.
export async function getStaticPaths() {
    const posts = await getPosts()
    return posts.map((post) => {
        return { params: { slug: post.slug }, props: { post } }
    })
}

const { post } = Astro.props as { post: BlogPost }
const { Content } = await render(post.entry as never)
---

<PostPage {post}>
    <Content />
</PostPage>
