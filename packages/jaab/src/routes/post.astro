---
import type { BlogPost } from '../posts.ts'
import Layout from 'virtual:jaab/layout'
import { postPage } from '../layout.ts'
import { getPosts } from '../posts.ts'

// A post's aliases are Astro redirects, set up by the integration.
export async function getStaticPaths() {
    const posts = await getPosts()
    return posts.map((post) => {
        return { params: { slug: post.slug }, props: { post } }
    })
}

const { post } = Astro.props as { post: BlogPost }
const { props, Content } = await postPage(post)
---

<Layout {...props}>{Content && <Content />}</Layout>
