---
import type { DocsHeading } from '../../@types/docs.ts'
import type { DocsNavGroup } from '../../navigation.ts'
import { ui } from '../../docs-config.ts'
import { formatChapterTitle } from '../../utils/docs.ts'
import ScrollToTop from '../ScrollToTop.astro'

interface Props {
    locale?: string
    groups: DocsNavGroup[]
    headings: DocsHeading[]
}

const { groups, headings, locale } = Astro.props
const t = ui(locale)
---

<div class="docs-mobile-nav">
    <div class="docs-select">
        <label for="page-select" class="jaad-sr-only">
            {t('nav.selectPage')}
        </label>
        <select id="page-select" class="docs-select-field">
            {groups.map((group) =>
                group.type === 'page' ? (
                    <option value={group.item.href} selected={group.item.isActive}>
                        {group.item.title}
                    </option>
                ) : (
                    <optgroup label={formatChapterTitle(group.chapter) || group.chapter}>
                        {group.items.map((page) => (
                            <option value={page.href} selected={page.isActive}>
                                {page.title}
                            </option>
                        ))}
                    </optgroup>
                ),
            )}
        </select>
    </div>

    {headings.length > 0 && (
        <div id="section-select-wrapper" class="docs-select">
            <label for="section-select" class="jaad-sr-only">
                Jump to section
            </label>
            <select id="section-select" class="docs-select-field">
                <option value="">{t('nav.jumpToSection')}</option>
                {headings.map((heading) => {
                    const prefix = heading.depth === 3 ? '\u00A0\u00A0\u00A0\u00A0' : ''
                    return (
                        <option value={`#${heading.slug}`}>
                            {prefix}
                            {heading.text}
                        </option>
                    )
                })}
            </select>
        </div>
    )}
</div>

<ScrollToTop {locale} />

<script>
    import { navigate } from 'astro:transitions/client'

    function initMobileNav(): void {
        const pageSelect = document.querySelector<HTMLSelectElement>('#page-select')
        const sectionSelect = document.querySelector<HTMLSelectElement>('#section-select')

        if (pageSelect && !pageSelect.dataset.navInit) {
            pageSelect.dataset.navInit = '1'
            pageSelect.addEventListener('change', () => {
                if (pageSelect.value) navigate(pageSelect.value)
            })
        }

        if (sectionSelect && !sectionSelect.dataset.navInit) {
            sectionSelect.dataset.navInit = '1'
            sectionSelect.addEventListener('change', () => {
                const target = sectionSelect.value
                if (!target) return
                document.querySelector(target)?.scrollIntoView({ behavior: 'smooth', block: 'start' })
                // Reset so picking the same section twice in a row fires again.
                setTimeout(() => (sectionSelect.value = ''), 500)
            })
        }
    }

    initMobileNav()
    document.addEventListener('astro:page-load', initMobileNav)
</script>
