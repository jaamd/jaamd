---
import { navLinks } from './nav-links.ts'

interface Props {
    locale?: string
    section?: string
}

const links = await navLinks(Astro.props.locale, Astro.props.section)
---

{links.length > 0 && (
    <nav class="jaad-nav">
        <ul class="jaad-nav-list">
            {links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class="jaad-nav-link"
                        aria-current={link.current ? 'true' : undefined}
                        {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
)}
