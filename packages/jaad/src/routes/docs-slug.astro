---
import { render } from 'astro:content'
import { getSortedDocsPages } from '../collection.ts'
import DocsPage from '../components/docs/DocsPage.astro'
import { buildLocales, docsUrls, localePrefix } from '../docs-config.ts'
import { docsPageHref, withDeploymentBase } from '../urls.ts'
import { docAliases, docCanonicalSlug, docTitle } from '../utils/docs.ts'

interface DocsPath {
    params: { slug: string }
    /** `redirect` is the canonical slug of a page reached by another name. */
    props: { id: string; locale?: string; redirect?: string }
}

export async function getStaticPaths() {
    const paths: DocsPath[] = []

    for (const locale of buildLocales()) {
        const sortedPages = await getSortedDocsPages(locale)
        const prefix = localePrefix(locale)

        sortedPages.forEach((page, index) => {
            const add = (slug: string, redirect?: string) =>
                paths.push({ params: { slug }, props: { id: page.id, locale, redirect } })

            const canonical = docCanonicalSlug(page, index, sortedPages)

            // Empty is the index route's; a prefixed locale has none, so /it is this page.
            const own = `${prefix}${canonical}`.replace(/\/$/, '')
            if (own) add(own)
            for (const alias of docAliases(page, index, sortedPages)) add(`${prefix}${alias}`, canonical)
        })
    }

    return paths
}

const { id, locale, redirect } = Astro.props

if (redirect !== undefined) {
    return Astro.redirect(docsPageHref(redirect, docsUrls(locale)), 301)
}

const sortedPages = await getSortedDocsPages(locale)
const docPage = sortedPages.find((page) => page.id === id)
if (!docPage) {
    return Astro.redirect(withDeploymentBase('/404', import.meta.env.BASE_URL))
}

const { Content } = await render(docPage)
---

<DocsPage entry={docPage} {sortedPages} headTitle={docTitle(docPage)}>
    <Content />
</DocsPage>
