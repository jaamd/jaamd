---
import { render } from 'astro:content'
import { buildLocales, localePrefix } from '../../site/runtime.ts'
import { withDeploymentBase } from '../../site/urls.ts'
import { getDocsTree } from '../collection.ts'
import DocsPage from '../components/DocsPage.astro'
import { docsUrls } from '../runtime.ts'
import { docsPageHref } from '../urls.ts'

interface DocsPath {
    params: { slug: string }
    /** `redirect` is the canonical slug of a page reached by another name. */
    props: { id: string; locale?: string; redirect?: string }
}

export async function getStaticPaths() {
    const paths: DocsPath[] = []

    for (const locale of buildLocales()) {
        const { pages } = await getDocsTree(locale)
        const prefix = localePrefix(locale)

        for (const page of pages) {
            const add = (slug: string, redirect?: string) =>
                paths.push({ params: { slug }, props: { id: page.id, locale, redirect } })

            // Empty is the index route's; a prefixed locale has none, so /it is this page.
            const own = `${prefix}${page.canonical}`.replace(/\/$/, '')
            if (own) add(own)
            for (const alias of page.aliases) add(`${prefix}${alias}`, page.canonical)
        }
    }

    return paths
}

const { id, locale, redirect } = Astro.props

if (redirect !== undefined) {
    return Astro.redirect(docsPageHref(redirect, docsUrls(locale)), 301)
}

const tree = await getDocsTree(locale)
const page = tree.byId.get(id)
if (!page) {
    return Astro.redirect(withDeploymentBase('/404', import.meta.env.BASE_URL))
}

const { Content } = await render(page.source)
---

<DocsPage {page} {tree} headTitle={page.title}>
    <Content />
</DocsPage>
