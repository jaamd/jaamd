---
import { render } from 'astro:content'
import { withDeploymentBase } from '../../site/urls.ts'
import { getDocsTree } from '../collection.ts'
import DocsPage from '../components/DocsPage.astro'

const tree = await getDocsTree()

const page = tree.pages[0]
if (!page) {
    return Astro.redirect(withDeploymentBase('/404', import.meta.env.BASE_URL))
}

const { Content } = await render(page.source)
---

<DocsPage {page} {tree}>
    <Content />
</DocsPage>
