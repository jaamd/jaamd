---
import type { ComponentProps } from 'astro/types'
import Shell from '@jaamd/site/layouts/Shell.astro'
import { DEFAULT_LOCALE } from '@jaamd/site/runtime.ts'
import { getLocaleAlternates } from '../collection.ts'
import { docsUrls } from '../runtime.ts'
import { docsFileHref } from '../urls.ts'
// JAAD's stylesheet holds the shell's rules; the project's own come after it.
import '../../../dist/jaad.css'
import 'virtual:jaad/theme.css'
import 'virtual:jaad/bridge.css'
import 'virtual:jaad/user.css'
import 'virtual:jaad/tailwind.css'

type Props = Omit<ComponentProps<typeof Shell>, 'header'>

// A page of the project's own has no translations: offer each locale's opener.
const alternates = await getLocaleAlternates('')
const indexUrl = docsFileHref('search-index.json', docsUrls(DEFAULT_LOCALE))
---

<Shell {...Astro.props} header={{ alternates, search: { indexUrl } }}>
    <slot />
</Shell>
