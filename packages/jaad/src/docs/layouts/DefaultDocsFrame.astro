---
import type { DocsFrameProps } from '../advanced.ts'

type Props = DocsFrameProps
---

<div data-jaad-default-frame class="docs-frame">
    <slot name="header" />

    <div class="docs-container">
        <slot name="sidebar" />

        <div class="docs-main">
            <main class="docs-page-main">
                <slot name="mobile-navigation" />

                <article>
                    <slot name="breadcrumbs" />
                    <slot name="content" />
                </article>

                <slot name="page-navigation" />
            </main>
        </div>

        <aside class="docs-sidebar-right jaad-sidebar">
            <slot name="table-of-contents" />
            <slot name="page-actions" />
        </aside>

        <slot name="footer" />
    </div>
</div>
