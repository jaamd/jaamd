---
import type { DocsNavGroup } from '../navigation.ts'
import type { DocsHeading, DocsNavItem } from '../types.ts'
import { ui } from '../../site/runtime.ts'
import { formatChapterTitle } from '../model/ids.ts'
import DocsNavTree from './DocsNavTree.astro'

interface Props {
    locale?: string
    groups: DocsNavGroup[]
    headings: DocsHeading[]
}

const { groups, headings, locale } = Astro.props
const t = ui(locale)

/** Section, chapter and page of the current page, as the menu's label. */
function trail(): string[] {
    for (const group of groups) {
        const entries = group.type === 'section' ? group.entries : [group]
        const section = group.type === 'section' ? [group.label] : []
        for (const entry of entries) {
            const items: DocsNavItem[] = entry.type === 'page' ? [entry.item] : entry.items
            const current = items.find((item) => item.isActive)
            if (!current) continue
            const chapter = entry.type === 'chapter' ? [formatChapterTitle(entry.chapter) ?? entry.chapter] : []
            return [...section, ...chapter, current.title]
        }
    }
    return []
}

const path = trail()
---

<div class="docs-mobile-nav">
    <details class="docs-mobile-menu">
        <summary class="docs-mobile-summary">
            <svg class="docs-mobile-icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                <path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z" />
            </svg>
            <span class="jaad-sr-only">{t('nav.documentation')}:</span>
            {path.map((part, index) => (
                <>
                    {index > 0 && <span aria-hidden="true">/</span>}
                    <span class:list={[index === path.length - 1 && 'docs-mobile-current']}>{part}</span>
                </>
            ))}
        </summary>
        <nav aria-label={t('nav.documentation')} class="docs-mobile-tree">
            <DocsNavTree {groups} />
        </nav>
    </details>

    {headings.length > 0 && (
        <details class="docs-mobile-menu">
            <summary class="docs-mobile-summary">{t('toc.title')}</summary>
            <nav aria-label={t('toc.label')} class="docs-mobile-tree">
                <ul class="docs-toc-list">
                    {headings.map((heading) => (
                        <li>
                            <a
                                href={`#${heading.slug}`}
                                class:list={['docs-toc-link', heading.depth === 3 && 'docs-toc-link-nested']}
                            >
                                {heading.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </details>
    )}
</div>

<script>
    // A chosen entry closes its menu, so the page it opens is not covered.
    function closeOnChoice(): void {
        for (const menu of document.querySelectorAll<HTMLDetailsElement>('.docs-mobile-menu')) {
            if (menu.dataset.navInit) continue
            menu.dataset.navInit = '1'
            menu.addEventListener('click', (event) => {
                if ((event.target as Element).closest('a')) menu.open = false
            })
        }
    }

    closeOnChoice()
    document.addEventListener('astro:page-load', closeOnChoice)
</script>
