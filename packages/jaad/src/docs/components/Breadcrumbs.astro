---
import { ui } from '../../site/runtime.ts'
import { getSectionLinks } from '../collection.ts'
import { formatChapterTitle } from '../model/ids.ts'

interface Props {
    /** The key of the section the page belongs to. */
    section?: string
    chapter?: string
    locale?: string
}

const { section, chapter, locale } = Astro.props
const t = ui(locale)
const chapterTitle = formatChapterTitle(chapter)
const sectionLink = section ? (await getSectionLinks(locale)).find((link) => link.key === section) : undefined
---

{(sectionLink || chapterTitle) && (
    <nav aria-label={t('breadcrumb.label')} class="docs-breadcrumbs">
        {sectionLink && (
            <a href={sectionLink.href} class="docs-breadcrumbs-link">
                {sectionLink.label}
            </a>
        )}
        {sectionLink && chapterTitle && <span aria-hidden="true">·</span>}
        {chapterTitle && <span>{chapterTitle}</span>}
    </nav>
)}
