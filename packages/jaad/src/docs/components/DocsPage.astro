---
import type { DocsSourceEntry } from '../collection.ts'
import type { DocsPage, DocsTree } from '../model/tree.ts'
import MarkdownContent from '@jaamd/astro/components'
import config from 'virtual:jaad/config'
import { DEFAULT_LOCALE, LOCALES, ui } from '../../site/runtime.ts'
import DocsLayout from '../layouts/Docs.astro'
import { pageHeadings } from '../model/rendered.ts'
import { buildDocsNavigation } from '../navigation.ts'
import { SECTIONS } from '../runtime.ts'
import Breadcrumbs from './Breadcrumbs.astro'
import DocsMobileNav from './DocsMobileNav.astro'
import DocsPageNav from './DocsPageNav.astro'
import PageActions from './PageActions.astro'

interface Props {
    page: DocsPage<DocsSourceEntry>
    tree: DocsTree<DocsSourceEntry>
    /** Left out on the opening page, whose title is the site name alone. */
    headTitle?: string
}

const { page, tree, headTitle } = Astro.props

const section = SECTIONS.find((known) => known.key === page.section)
// With sections, the title names the section after the page.
const title = headTitle && section ? `${headTitle} · ${section.label}` : headTitle
// A section's files sit in its own directory.
const editBase = section ? section.editBase : config.docs.editBase
const editPath = [page.locale, page.path].filter(Boolean).join('/')
const headings = pageHeadings(page.source.rendered)
const t = ui(page.locale)
const language = LOCALES.find((known) => known.code === (page.locale ?? DEFAULT_LOCALE))?.tag ?? config.lang
const updated = page.data.lastUpdated
const navigation = buildDocsNavigation(tree, page.id, SECTIONS)
const contentAttrs = { id: 'content' }
---

<DocsLayout {title} {page} {headings} {navigation}>
    <DocsMobileNav slot="mobile-navigation" groups={navigation.groups} headings={headings} locale={page.locale} />

    <Breadcrumbs slot="breadcrumbs" section={page.section} chapter={page.chapter} locale={page.locale} />
    <PageActions slot="page-actions" {editBase} {editPath} cleanSlug={page.slug} locale={page.locale} />

    <Fragment slot="content">
        <MarkdownContent {...contentAttrs} class="docs-content">
            <slot />
        </MarkdownContent>

        {updated && (
            <p class="docs-updated">
                {t('page.lastUpdated')}{' '}
                <time datetime={updated.toISOString()}>
                    {new Intl.DateTimeFormat(language, { dateStyle: 'long' }).format(updated)}
                </time>
            </p>
        )}
    </Fragment>

    <DocsPageNav
        slot="page-navigation"
        previousPage={navigation.previousPage}
        nextPage={navigation.nextPage}
        locale={page.locale}
    />
</DocsLayout>
