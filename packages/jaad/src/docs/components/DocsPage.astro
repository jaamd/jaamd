---
import type { DocsSourceEntry } from '../collection.ts'
import type { DocsPage, DocsTree } from '../model/tree.ts'
import MarkdownContent from '@jaamd/astro/components'
import Authors from '@jaamd/site/components/Authors.astro'
import PageActions from '@jaamd/site/components/PageActions.astro'
import { fill } from '@jaamd/site/helpers.ts'
import { editUrl } from '@jaamd/site/infer.ts'
import { pageHeadings, pageReadingMinutes } from '@jaamd/site/rendered.ts'
import { languageOf, ui } from '@jaamd/site/runtime.ts'
import config from 'virtual:jaad/config'
import DocsLayout from '../layouts/Docs.astro'
import { editPathFor } from '../model/ids.ts'
import { buildDocsNavigation } from '../navigation.ts'
import { SECTIONS, docsPageAuthors, docsUrls } from '../runtime.ts'
import { docsMarkdownHref } from '../urls.ts'
import Breadcrumbs from './Breadcrumbs.astro'
import DocsMobileNav from './DocsMobileNav.astro'
import DocsPageNav from './DocsPageNav.astro'

interface Props {
    page: DocsPage<DocsSourceEntry>
    tree: DocsTree<DocsSourceEntry>
    /** Left out on the opening page, whose title is the site name alone. */
    headTitle?: string | undefined
}

const { page, tree, headTitle } = Astro.props

const section = SECTIONS.find((known) => {
    return known.key === page.section
})
// With sections, the title names the section after the page.
const title = headTitle && section ? `${headTitle} · ${section.label}` : headTitle
// A section's files sit in its own directory.
const editBase = section ? section.editBase : config.docs.editBase
const editPath = editPathFor(
    page.source.filePath,
    section ? section.dir : config.docs.dir,
    [page.locale, page.path].filter(Boolean).join('/'),
)
const editHref = editBase ? editUrl(editBase, editPath) : null
const markdownHref = docsMarkdownHref(page.slug, docsUrls(page.locale))
const headings = pageHeadings(page.source.rendered)
const t = ui(page.locale)
const language = languageOf(page.locale)
const updated = page.data.lastUpdated
const authors = docsPageAuthors(page.data)
const minutes = config.docs.readingTime ? pageReadingMinutes(page.source.rendered) : null
const navigation = buildDocsNavigation(tree, page.id, SECTIONS)
const contentAttrs = { id: 'content' }
---

<DocsLayout {title} {page} {headings} {navigation}>
    <DocsMobileNav slot="mobile-navigation" groups={navigation.groups} headings={headings} locale={page.locale} />

    <Breadcrumbs slot="breadcrumbs" section={page.section} chapter={page.chapter} locale={page.locale} />
    <PageActions slot="page-actions" {markdownHref} {editHref} locale={page.locale} />

    <Fragment slot="content">
        {(authors.length > 0 || minutes !== null) && (
            <p class="docs-page-meta">
                {authors.length > 0 && (
                    <span>
                        <Authors {authors} {language} />
                    </span>
                )}
                {authors.length > 0 && minutes !== null && <span aria-hidden="true">·</span>}
                {minutes !== null && <span>{fill(t('page.minutes'), { minutes })}</span>}
            </p>
        )}
        <MarkdownContent {...contentAttrs} class="docs-content">
            <slot />
        </MarkdownContent>

        {updated && (
            <p class="docs-updated">
                {t('page.lastUpdated')}{' '}
                <time datetime={updated.toISOString()}>
                    {new Intl.DateTimeFormat(language, { dateStyle: 'long' }).format(updated)}
                </time>
            </p>
        )}
    </Fragment>

    <DocsPageNav
        slot="page-navigation"
        previousPage={navigation.previousPage}
        nextPage={navigation.nextPage}
        locale={page.locale}
    />
</DocsLayout>
