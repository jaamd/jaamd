---
import config from 'virtual:jaad/config'
import { scriptJson } from '../../site/helpers.ts'
import { slugToTitle } from '../model/ids.ts'
import { docsUrls } from '../runtime.ts'
import { docsPageHref } from '../urls.ts'

interface Props {
    title: string
    description: string
    chapter?: string
    keywords?: string[]
    author?: string
    modified?: Date
    /** BCP-47 tag of this page's locale. */
    language?: string
    locale?: string
}

const { title, description, chapter, keywords = [], author, modified, language = config.lang, locale } = Astro.props

// Relative ids are worthless to a crawler, so without `site` emit nothing.
const site = Astro.site
const base = site ? docsPageHref('', docsUrls(locale)) : null

const crumbs = base
    ? [
          { name: config.title, url: new URL(base, Astro.url.origin).href },
          ...(chapter ? [{ name: slugToTitle(chapter), url: null }] : []),
          { name: title, url: Astro.url.href },
      ]
    : []

const data = base && {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    inLanguage: language,
    ...(keywords.length > 0 ? { keywords } : {}),
    ...(author ? { author: { '@type': 'Person', name: author } } : {}),
    ...(modified ? { dateModified: modified.toISOString() } : {}),
    isPartOf: { '@type': 'WebSite', name: config.title },
    breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((crumb, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: crumb.name,
            ...(crumb.url ? { item: crumb.url } : {}),
        })),
    },
}

// `<` escaped: a `</script>` in a title or description would close the element.
const json = data ? scriptJson(data) : ''
---

{data && <script type="application/ld+json" set:html={json} is:inline />}
