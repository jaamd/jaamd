---
import type { DocsNavEntry, DocsNavGroup } from '../navigation.ts'
import { ui } from '../../site/runtime.ts'
import { formatChapterTitle } from '../model/ids.ts'

interface Props {
    groups: DocsNavGroup[]
    locale?: string
}

const { groups, locale } = Astro.props
const t = ui(locale)

/** The pages outside every section, then one block per section. */
const loose = groups.filter((group): group is DocsNavEntry => group.type !== 'section')
const blocks = [
    ...(loose.length > 0 ? [{ label: null, entries: loose }] : []),
    ...groups.flatMap((group) => (group.type === 'section' ? [{ label: group.label, entries: group.entries }] : [])),
]
---

<aside class="docs-sidebar-left jaad-sidebar">
    <nav aria-label={t('nav.documentation')}>
        {blocks.map((block) => (
            <div class:list={[block.label && 'docs-sidebar-section']}>
                {block.label && <p class="docs-sidebar-section-title">{block.label}</p>}
                {block.entries.map((entry) =>
                    entry.type === 'page' ? (
                        <div class="docs-sidebar-page">
                            <a
                                href={entry.item.href}
                                class="docs-sidebar-link"
                                aria-current={entry.item.isActive ? 'page' : undefined}
                            >
                                {entry.item.title}
                            </a>
                        </div>
                    ) : (
                        <div class="docs-sidebar-chapter">
                            <h3 class="docs-sidebar-chapter-title">{formatChapterTitle(entry.chapter)}</h3>
                            <ul class="docs-sidebar-chapter-list">
                                {entry.items.map((item) => (
                                    <li>
                                        <a
                                            href={item.href}
                                            class="docs-sidebar-sublink"
                                            aria-current={item.isActive ? 'page' : undefined}
                                        >
                                            {item.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ),
                )}
            </div>
        ))}
    </nav>
</aside>

<script>
    const SELECTOR = '.docs-sidebar-left'
    let scrollTop = 0

    const sidebar = () => document.querySelector<HTMLElement>(SELECTOR)

    /** Scrolls the sidebar only, never the document, and only when needed. */
    function revealCurrent() {
        const el = sidebar()
        const current = el?.querySelector('[aria-current="page"]')
        if (!el || !current) return

        const box = el.getBoundingClientRect()
        const item = current.getBoundingClientRect()
        if (item.top >= box.top && item.bottom <= box.bottom) return

        el.scrollTop += item.top - box.top - (box.height - item.height) / 2
    }

    document.addEventListener('astro:before-swap', () => {
        scrollTop = sidebar()?.scrollTop ?? 0
    })

    document.addEventListener('astro:after-swap', () => {
        const el = sidebar()
        if (!el) return
        el.scrollTop = scrollTop
        // A deep link, or a page whose entry sits outside the restored window.
        revealCurrent()
    })

    revealCurrent()
</script>
