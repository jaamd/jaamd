{
    "name": "@jaamd/core",
    "version": "0.12.0",
    "description": "Framework-agnostic markdown plugins, markup, client-side enhancements, styles and themes behind JAAMD.",
    "keywords": [
        "markdown",
        "rehype",
        "remark",
        "satteri",
        "unified"
    ],
    "homepage": "https://jaamd.org",
    "bugs": {
        "url": "https://github.com/jaamd/jaamd/issues"
    },
    "license": "MIT",
    "author": "Kasui92 <info@lucapattocchio.dev>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jaamd/jaamd.git",
        "directory": "packages/core"
    },
    "files": [
        "src",
        "README.md"
    ],
    "type": "module",
    "exports": {
        "./unified": "./src/unified/index.ts",
        "./satteri": "./src/satteri.ts",
        "./client": "./src/client/enhancements.ts",
        "./default.css": "./src/styles/variables.css",
        "./styles.css": "./src/styles/markdown.css",
        "./shiki-dual.css": "./src/styles/shiki-dual.css",
        "./themes": {
            "types": "./src/themes/index.d.ts",
            "default": "./src/themes/index.js"
        },
        "./themes/*/dark.css": "./src/themes/*/dark.css",
        "./themes/*.css": "./src/themes/*/index.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "check": "tsc --noEmit",
        "build:themes": "node scripts/build-themes.mjs",
        "test": "node tests/slug-parity.mjs && node tests/themes.mjs && node --import ./tests/ts-resolve.mjs --test \"tests/**/*.test.mjs\""
    },
    "dependencies": {
        "remark-directive": "^4.0.0",
        "unist-util-visit": "^5.0.0"
    },
    "devDependencies": {
        "@types/hast": "^3.0.5",
        "@types/mdast": "^4.0.4",
        "github-slugger": "^2.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "satteri": "^0.10.5",
        "shiki": "4.4.3",
        "typescript": "^6.0.0",
        "unified": "^11.0.0"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
