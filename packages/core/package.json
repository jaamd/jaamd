{
    "name": "@jaamd/core",
    "version": "0.12.0",
    "description": "Framework-agnostic markdown plugins, markup, client-side enhancements, styles and themes behind JAAMD.",
    "keywords": [
        "markdown",
        "rehype",
        "remark",
        "satteri",
        "unified"
    ],
    "homepage": "https://jaamd.org",
    "bugs": {
        "url": "https://github.com/jaamd/jaamd/issues"
    },
    "license": "MIT",
    "author": "Kasui92 <info@lucapattocchio.dev>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jaamd/jaamd.git",
        "directory": "packages/core"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "exports": {
        "./unified": {
            "types": "./dist/unified/index.d.ts",
            "default": "./dist/unified/index.js"
        },
        "./satteri": {
            "types": "./dist/satteri/index.d.ts",
            "default": "./dist/satteri/index.js"
        },
        "./client": {
            "types": "./dist/client/index.d.ts",
            "default": "./dist/client/index.js"
        },
        "./themes": {
            "types": "./dist/themes/index.d.ts",
            "default": "./dist/themes/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./default.css": "./dist/default.css",
        "./shiki-dual.css": "./dist/shiki-dual.css",
        "./themes/*/dark.css": "./dist/themes/*/dark.css",
        "./themes/*.css": "./dist/themes/*/index.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "prepare": "pnpm build",
        "check": "tsc --noEmit && tsc --noEmit -p tests",
        "test": "node --test \"tests/**/*.test.ts\"",
        "test:consumer": "pnpm build && node --test \"tests/consumer/**/*.test.mjs\""
    },
    "dependencies": {
        "@types/hast": "^3.0.5",
        "@types/mdast": "^4.0.4",
        "remark-directive": "^4.0.0",
        "unified": "^11.0.0",
        "unist-util-visit": "^5.0.0"
    },
    "devDependencies": {
        "github-slugger": "^2.0.0",
        "happy-dom": "^21.0.4",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "satteri": "^0.10.5",
        "shiki": "4.4.3",
        "typescript": "^6.0.0"
    },
    "peerDependencies": {
        "satteri": ">=0.10.0 <1"
    },
    "peerDependenciesMeta": {
        "satteri": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
